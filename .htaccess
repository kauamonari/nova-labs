# ============================================================
# NØVA LABS — Clean URLs (remove .html extension)
# Compatible with Apache / Hostinger shared hosting
# ============================================================

RewriteEngine On

# 1) If someone requests /pagina.html directly, redirect (301) to /pagina
#    (avoids duplicate content: novalabsbr.com/servicos.html vs /servicos)
RewriteCond %{THE_REQUEST} /([^.]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [NC,L,R=301]

# 2) Internally serve the .html file when the clean URL is requested
#    (the visitor never sees .html in the address bar)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^.]+)$ $1.html [NC,L]

# 3) /index should always resolve to the root domain
RewriteCond %{THE_REQUEST} /index[\s?] [NC]
RewriteRule ^index$ / [R=301,L]

# 4) Custom 404 (optional — remove if you don't have a 404.html)
# ErrorDocument 404 /404.html
